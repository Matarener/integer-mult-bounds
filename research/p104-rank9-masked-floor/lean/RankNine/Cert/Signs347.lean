import RankNine.Signs
import RankNine.Cert.Packed347

/-! Bit-packed T1 sign certificate for framed type 347 (generated by gen/emit_signs.py):
269 quadruple rows, 0 relation rows, 1 classes, 269 combination entries. -/

namespace RankNine.Signs347

open Matrix RankNine.Packed347

def nK : ℕ := 1
def nq : ℕ := 269
def nrows : ℕ := 269
def CR : List ℕ := [0x230]
def QS : List ℕ := [, , , , , , , , , , , ]
def RS : List ℕ := []
def CQ : List ℕ := [0x0]
def CB : List ℕ := [, 0x10c010b010a0109010801070106010501040103010201010100]
def CO : List ℕ := [0x10d0000]

theorem r0 : (List.range' 0 200).all (rowOK (typeMask.getD 347 0) nQ nK T CR QS RS nq) = true := by decide +kernel

theorem r1 : (List.range' 200 69).all (rowOK (typeMask.getD 347 0) nQ nK T CR QS RS nq) = true := by decide +kernel

theorem r_ok : ∀ j < 269, (rowOK (typeMask.getD 347 0) nQ nK T CR QS RS nq) j = true := by
  intro j hj
  by_cases h0 : j < 200
  · exact (all_range'_iff _ 0 200).1 r0 j (by omega) (by omega)
  exact (all_range'_iff _ 200 69).1 r1 j (by omega) (by omega)

theorem c0 : (List.range' 0 1).all (classOK QS CQ nq) = true := by decide +kernel

theorem c_ok : ∀ c < 1, (classOK QS CQ nq) c = true := by
  intro c hc
  exact (all_range'_iff _ 0 1).1 c0 c (by omega) (by omega)

theorem x0 : (List.range' 0 1).all (comboOK T QS RS nq nrows CB CO) = true := by decide +kernel

theorem x_ok : ∀ c < 1, (comboOK T QS RS nq nrows CB CO) c = true := by
  intro c hc
  exact (all_range'_iff _ 0 1).1 x0 c (by omega) (by omega)

/-- T1 sign step for type 347: every quadruple class has magnitude bit 0, i.e. `N = 1/4` on its quadruples
(`RankNine.quad_quarter`). -/
theorem mags {K : Type*} [Field K] [CharZero K] (A B : ℕ → Fin 9 → K) (u : Fin 9 → K) (hu : u ≠ 0)
    (hZ : ∀ x, (typeMask.getD 347 0).testBit x = true → A x ⬝ᵥ u = 0)
    (hdiag : ∀ x < 104, A x ⬝ᵥ B x ≠ 0) (hmask : ∀ x < 104, ∀ y < 104, orth x y = true → A x ⬝ᵥ B y = 0)
    (hcov : ∀ c, covB Cv c = true → Nc A B c ≠ 0) :
    ∀ c < nK, magN (Nc A B (fld CR c)) = 0 :=
  signs_sound A B u hu _ hZ hdiag hmask nQ nK nq nrows T CR QS RS CQ CB CO
    (moduli_geom A B u hu hZ hdiag hmask hcov) (fun j hj => r_ok j hj) (by decide)
    (fun c hc => c_ok c hc) (fun c hc => x_ok c hc)

end RankNine.Signs347

