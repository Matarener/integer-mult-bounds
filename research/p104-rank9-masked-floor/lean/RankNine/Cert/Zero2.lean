/-- zero step for type 2: `N ≠ 0` on the whole cover set of the moduli certificate -/
theorem cov_ne {K : Type*} [Field K] (A B : ℕ → Fin 9 → K) (u : Fin 9 → K) (hu : u ≠ 0)
    (hZ : ∀ x, (typeMask.getD 2 0).testBit x = true → A x ⬝ᵥ u = 0)
    (hdiag : ∀ x < 104, A x ⬝ᵥ B x ≠ 0) (hmask : ∀ x < 104, ∀ y < 104, orth x y = true → A x ⬝ᵥ B y = 0) :
    ∀ c, covB Packed2.Cv c = true → Nc A B c ≠ 0 :=
  zero_sound A B u hu _ hZ hdiag hmask Packed2.Cv E Lt Hn n entries_ok last_ok (by decide)

/-- moduli step for type 2 without the cover hypothesis -/
theorem moduli_full {K : Type*} [Field K] (A B : ℕ → Fin 9 → K) (u : Fin 9 → K) (hu : u ≠ 0)
    (hZ : ∀ x, (typeMask.getD 2 0).testBit x = true → A x ⬝ᵥ u = 0)
    (hdiag : ∀ x < 104, A x ⬝ᵥ B x ≠ 0) (hmask : ∀ x < 104, ∀ y < 104, orth x y = true → A x ⬝ᵥ B y = 0) :
    ∀ q < Packed2.nQ, Nc A B (fld Packed2.T (3 * q)) ^ 2 = Nc A B (fld Packed2.T (3 * q + 1)) ^ 2 :=
  Packed2.moduli_geom A B u hu hZ hdiag hmask (cov_ne A B u hu hZ hdiag hmask)

