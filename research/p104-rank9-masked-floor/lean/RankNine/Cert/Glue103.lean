theorem hT : T.all (pcOK zm) = true := by decide +kernel
theorem hc : coverOK O bad T = true := by decide +kernel
theorem hm : matchOK O bad = true := by decide +kernel
theorem hf : fiveOK O bad = true := by decide +kernel
