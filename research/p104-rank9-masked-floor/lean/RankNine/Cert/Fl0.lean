import RankNine.Cert.Gram0
import RankNine.Cert.Zero0
import RankNine.Cert.Glue0
import RankNine.Floor

set_option linter.unusedSectionVars false

/-! Floor for framed type 0 (generated by gen/emit_t3.py): frame 6 = [0, 7, 16, 20, 79, 86, 97, 103] inside `Z`, special line U = 104. -/

namespace RankNine.Fl0

open Matrix

def f : ℕ := 6
theorem hzmeq : Glue0.zm = Gram0.zm := by decide +kernel
theorem hfin : frInOK (typeMask.getD 0 0) Glue0.zm f = true := by decide +kernel
theorem hfv : fvecOK f = true := by decide +kernel
theorem hzm : (List.range 104).all (fun x => !Glue0.zm.testBit x || (typeMask.getD 0 0).testBit x) = true := by
  decide +kernel
theorem hOG : (List.range 104).all
    (fun v => Glue0.zm.testBit v || decide (v ∈ Glue0.O) || (typeMask.getD 0 0).testBit v) = true := by
  decide +kernel

/-- **C(P104) ≥ 56 for framed type 0** (hypotheses of BForm: `Capacity`, `BicliqueFact`, `CensusFact`). -/
theorem floor {K : Type*} [Field K] [CharZero K] (hcap : BForm.Capacity BForm.E8.labK)
    (hbic : BForm.BicliqueFact (BForm.E8.rK K)) (hcensus : BForm.CensusFact BForm.E8.labK (BForm.E8.rK K))
    (A B : ℕ → Fin 9 → K) (u : Fin 9 → K) (hu : u ≠ 0)
    (hZ : ∀ x, (typeMask.getD 0 0).testBit x = true → A x ⬝ᵥ u = 0)
    (hdiag : ∀ x < 104, A x ⬝ᵥ B x ≠ 0) (hmask : ∀ x < 104, ∀ y < 104, orth x y = true → A x ⬝ᵥ B y = 0)
    (Al Bl : Matrix (Fin 9) (Fin 104) K) (hA : Al * Matrix.of (fun (v : Fin 104) (i : Fin 9) => A v i) = 1)
    (hB : Bl * Matrix.of (fun (v : Fin 104) (i : Fin 9) => B v i) = 1)
    (P' Q' : Matrix (Fin 104) BForm.C9 K) (h : Matrix.of (fun v s : Fin 104 => Mx A B v s) = P' * Q'ᵀ) :
    56 ≤ BForm.cost BForm.E8.labK P' Q' := by
  obtain ⟨hg, hG⟩ := Gram0.gramZ A B u hu hZ hdiag hmask (Zero0.cov_ne A B u hu hZ hdiag hmask)
  rw [← hzmeq] at hG
  obtain ⟨lam, eta, hrep, -, hin, hcolU, hrowd, hglue, hpinT⟩ := t3_type A B u hu hZ hdiag hmask _ hg hG hfin hfv
    Glue0.hz hzm Glue0.hOL Glue0.hO Glue0.hcov hOG Glue0.hsm Glue0.hsmlt
    (fun v hv d h1 hd => Glue0.line hv d h1 hd) (fun h τ L R five => Glue0.glue R five) Glue0.hSP
  exact floor_noU hcap hbic hcensus _ _ _ lam eta (fun v s => by rw [Matrix.of_apply]; exact hrep v s)
    (fun s hs => hcolU s hs (by simp only [Glue0.U]; omega)) hrowd (hPs_P104 A B _ f)
    (hglue.imp_right (live_le_four lam _ hin)) (fun t => by rw [Matrix.of_apply]; exact hdiag t t.2)
    (fun x y hd => by rw [Matrix.of_apply]; exact hmask x x.2 y y.2 (by simp [orth, hd]))
    _ _ Al Bl hA hB (by ext v s; simp [Matrix.mul_apply, Mx, dotProduct]) P' Q' h

end RankNine.Fl0
