    (hcov : ∀ c, covB Cv c = true → Nc A B c ≠ 0) :
    ∀ c < nK, magN (Nc A B (fld CR c)) = 0 :=
  mu_sound A B u hu _ hZ hdiag hmask nQ nK nq nr Cv nO nX T CR QS RS CQ E Lt Hn OR XO XS XF nE hcov
