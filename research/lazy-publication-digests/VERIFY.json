{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [],
  "inputs": [
    "scripts/check_research_commit.py",
    "scripts/research_package.py",
    "tests/test_research_commit_bytes.py",
    "tests/test_research_source_history.py",
    "tests/test_research_commit_modes.py",
    "tests/test_research_git_replacements.py"
  ],
  "commands": [
    {
      "argv": [
        "{python}",
        "-I",
        "-W",
        "error",
