{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [
    "numpy==2.5.4"
  ],
  "inputs": [],
  "commands": [
    {
      "argv": [
        "{python}",
        "-W",
        "error",
        "-B",
        "{package}/verify.py"
      ],
      "timeout_seconds": 300,
      "checks": "Canonical solver equivalence, source rejection and complete accepted fold variant in baseline and candidate modes."
    },
    {
      "argv": [
        "{python}",
        "-O",
        "-W",
        "error",
        "-B",
        "{package}/verify.py"
      ],
      "timeout_seconds": 300,
      "checks": "The same full checks with assertions disabled in the verifier interpreter."
    }
  ]
}
