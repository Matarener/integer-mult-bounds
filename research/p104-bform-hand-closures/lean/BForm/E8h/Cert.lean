theorem e7_cert {K : Type*} [Field K] [CharZero K] (y : Fin 8 → K)
    (h0 : (![1, -1, -1, -1, -1, -1, -1, 1] : Fin 8 → K) ⬝ᵥ y = 0)
    (h1 : (![2, 2, 0, 0, 0, 0, 0, 0] : Fin 8 → K) ⬝ᵥ y = 0)
    (h2 : (![-2, 2, 0, 0, 0, 0, 0, 0] : Fin 8 → K) ⬝ᵥ y = 0)
    (h3 : (![0, -2, 2, 0, 0, 0, 0, 0] : Fin 8 → K) ⬝ᵥ y = 0)
    (h4 : (![0, 0, -2, 2, 0, 0, 0, 0] : Fin 8 → K) ⬝ᵥ y = 0)
    (h5 : (![0, 0, 0, -2, 2, 0, 0, 0] : Fin 8 → K) ⬝ᵥ y = 0)
    (h6 : (![0, 0, 0, 0, -2, 2, 0, 0] : Fin 8 → K) ⬝ᵥ y = 0)
    : y = (((![0, 0, 0, 0, 0, 0, 2, 2] : Fin 8 → K) ⬝ᵥ y) / 8) • (![0, 0, 0, 0, 0, 0, 2, 2] : Fin 8 → K) := by
  simp only [dotProduct, Fin.sum_univ_eight, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val] at *
  funext k
  fin_cases k <;> simp only [Pi.smul_apply, smul_eq_mul, dotProduct, Fin.sum_univ_eight, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk]
  · linear_combination (1/4) * h1 + (-1/4) * h2
  · linear_combination (1/4) * h1 + (1/4) * h2
  · linear_combination (1/4) * h1 + (1/4) * h2 + (1/2) * h3
  · linear_combination (1/4) * h1 + (1/4) * h2 + (1/2) * h3 + (1/2) * h4
  · linear_combination (1/4) * h1 + (1/4) * h2 + (1/2) * h3 + (1/2) * h4 + (1/2) * h5
  · linear_combination (1/4) * h1 + (1/4) * h2 + (1/2) * h3 + (1/2) * h4 + (1/2) * h5 + (1/2) * h6
  · linear_combination (-1/2) * h0 + (-1/2) * h1 + (-3/4) * h2 + (-1) * h3 + (-3/4) * h4 + (-1/2) * h5 + (-1/4) * h6
  · linear_combination (1/2) * h0 + (1/2) * h1 + (3/4) * h2 + (1) * h3 + (3/4) * h4 + (1/2) * h5 + (1/4) * h6

