    "research/gl3-rup-native-replay/source/drat-trim.c",
    "research/gl3-rup-native-replay/source/DRAT-LICENSE",
    "research/gl3-rup-native-replay/source/length7.cnf",
    "research/gl3-rup-native-replay/source/length8.cnf",
    "research/gl3-rup-native-replay/source/length7.rup.gz",
    "research/gl3-rup-native-replay/source/length8.rup.gz",
    "research/gl3-rup-native-replay/source/CHECKER.json",
    "research/gl3-rup-native-replay/source/CERTIFICATES.json",
    "research/gl3-rup-native-replay/source/NOTICE.md",
    "research/gl3-rup-native-replay/source/LICENSE",
