      "argv": [
        "{python}",
        "-I",
        "-O",
        "-W",
        "error",
        "-B",
        "{package}/verify.py",
        "--selftest"
      ],
      "timeout_seconds": 60,
      "checks": "Authenticate all immutable inputs, retained native raw logs and every proof-relevant typed receipt field, with decisive receipt corruptions. Inspection only; fresh native replay has its dedicated workflow."
    }
  ]
