    {
      "argv": ["{python}", "-Werror", "-I", "-B", "{package}/independent.py"],
      "timeout_seconds": 60,
      "checks": "Recompute the same integers and source obligations in a separate program."
    },
    {
      "argv": ["{python}", "-Werror", "-I", "-B", "{package}/test_package.py"],
      "timeout_seconds": 120,
      "checks": "Reject certificate corruption, duplicate JSON keys and drifted source bytes, including under -O."
    }
  ]
